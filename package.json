{
  "name": "@lightspeedwp/ls-wp-linting",
  "version": "1.0.0",
  "description": "Complete linting and code quality guidance for WordPress themes and plugins using ESLint, Prettier, PHPStan, markdownlint, and GitHub Actions workflows.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "lint": "npm run lint:js && npm run lint:markdown",
    "lint:js": "eslint . --ext .js,.mjs,.cjs --ignore-pattern node_modules --ignore-pattern '.git' --ignore-pattern 'sub-skills'",
    "lint:markdown": "markdownlint-cli2 '**/*.md' '!node_modules/**'",
    "format": "npm run format:js && npm run format:markdown",
    "format:js": "prettier --write '**/*.{js,mjs,cjs,json}' --ignore-path .gitignore",
    "format:markdown": "prettier --write '**/*.md' --ignore-path .gitignore",
    "test": "npm run test:unit && npm run test:bats",
    "test:unit": "jest --coverage --coveragePathIgnorePatterns=node_modules --coveragePathIgnorePatterns='.git'",
    "test:bats": "bats tests/**/*.bats",
    "test:all": "npm run lint && npm run test",
    "validate": "npm run lint && npm test"
  },
  "keywords": [
    "linting",
    "wordpress",
    "eslint",
    "prettier",
    "phpstan",
    "markdownlint",
    "code-quality"
  ],
  "author": "LightSpeed WP",
  "license": "MIT",
  "devDependencies": {
    "@wordpress/eslint-plugin": "^18.0.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^28.8.3",
    "jest": "^29.7.0",
    "markdownlint-cli2": "^0.12.1",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lightspeedwp/ls-wp-linting"
  },
  "bugs": {
    "url": "https://github.com/lightspeedwp/ls-wp-linting/issues"
  },
  "homepage": "https://github.com/lightspeedwp/ls-wp-linting"
}
