{
  "version": "0.1",
  "description": "Claude Code settings for the linting skill project",
  "project": {
    "name": "linting",
    "type": "skill",
    "language": "javascript",
    "framework": "claude-skills"
  },
  "permissions": {
    "allow": ["npm", "git", "bash", "node"]
  },
  "hooks": {
    "pre-commit": "npm run lint && npm test",
    "post-checkout": "npm install"
  },
  "testing": {
    "framework": "jest",
    "coverage": {
      "required": 100,
      "type": "unit"
    },
    "integration": {
      "framework": "bats",
      "required": true
    }
  },
  "linting": {
    "eslint": true,
    "prettier": {
      "enabled": true,
      "lineWidth": 100
    },
    "shellcheck": true,
    "markdownlint": true
  },
  "documentation": {
    "format": "markdown",
    "location": "docs/",
    "linting": "markdownlint"
  },
  "vcs": {
    "type": "git",
    "remote": "https://github.com/lightspeedwp/linting.git",
    "defaultBranch": "main",
    "branchStrategy": "lightspeed-wp"
  },
  "ci": {
    "provider": "github-actions",
    "config": ".github/workflows/"
  }
}
